{
	"name": "clusterix-news",
	"private": true,
	"scripts": {
		"dev": "bun --filter './apps/*' dev",
		"build": "bun --filter '*' build",
		"test": "bun --filter '*' test",
		"lint": "bunx biome check .",
		"fix": "bunx biome check --write .",
		"format": "bunx biome format --write .",
		"lint:changed": "bunx biome check --changed",
		"lint:staged": "bunx biome check --staged",
		"setup:env": "cp apps/api/.env.prod.example apps/api/.env.prod && cp .env.example .env",
		"setup:docker": "docker compose up -d --build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"lefthook": "^2.0.2"
	}
}
